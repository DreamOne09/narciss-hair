---
import "../styles/global.css";
import { SITE } from "../config/site";
import { asset } from "../lib/paths";
import Seo from "../components/Seo.astro";
import JsonLdLocalBusiness from "../components/JsonLdLocalBusiness.astro";
import DemoGate from "../components/DemoGate.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  withJsonLd?: boolean;
}

const { title, description, noindex = false, withJsonLd = false } = Astro.props;
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={asset("favicon.svg")} />
    <link rel="sitemap" href={asset("sitemap-index.xml")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&family=Noto+Serif+TC:wght@500;600&display=swap"
      rel="stylesheet"
    />
    <Seo title={title} description={description} noindex={noindex} />
    {withJsonLd && <JsonLdLocalBusiness />}
  </head>
  <body>
    <DemoGate />
    <div id="site-shell">
      <a href="#content" class="skip-link">{SITE.ui.skipToContent}</a>
      <Header />
      <main id="content">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
