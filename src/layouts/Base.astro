---
import "../styles/global.css";
import { SITE } from "../config/site";
import { asset } from "../lib/paths";
import Seo from "../components/Seo.astro";
import JsonLdLocalBusiness from "../components/JsonLdLocalBusiness.astro";
import DemoGate from "../components/DemoGate.astro";
import LegalChrome from "../components/LegalChrome.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  withJsonLd?: boolean;
}

const { title, description, withJsonLd = false } = Astro.props;
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={asset("favicon.svg")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Shippori+Mincho:wght@400;500;600;700&family=Noto+Sans+TC:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <Seo title={title} description={description} />
    {withJsonLd && <JsonLdLocalBusiness />}
  </head>
  <body>
    <DemoGate />
    <div id="site-shell">
      <a href="#content" class="skip-link">{SITE.ui.skipToContent}</a>
      <LegalChrome />
      <Header />
      <main id="content">
        <slot />
      </main>
      <Footer />
    </div>
    <script is:inline>
      (function () {
        var unveiled = false;
        function markCanvasReady() {
          if (unveiled) return;
          unveiled = true;
          document.documentElement.classList.add("canvas-ready");
        }
        if (!document.getElementById("demo-gate")) {
          markCanvasReady();
        } else {
          document.addEventListener("narciss:canvas-unveil", markCanvasReady, { once: true });
        }
        window.addEventListener(
          "scroll",
          function () {
            if (window.scrollY > 6) markCanvasReady();
          },
          { once: true, passive: true }
        );
      })();
    </script>
  </body>
</html>
