---
import { SITE } from "../config/site";
import { route, anchor } from "../lib/paths";
---

<header class="site-header">
  <div class="container header-inner">
    <a href={route()} class="brand" aria-label="NARCISS HAIR 首頁">
      <span class="brand-mark">NARCISS</span><span class="brand-mark-sub"> HAIR</span>
    </a>

    <button
      id="menu-burger"
      class="burger"
      type="button"
      aria-expanded="false"
      aria-controls="main-menu"
      aria-label={SITE.ui.menuOpenLabel}
    >
      <span></span><span></span><span></span>
    </button>

    <nav id="main-menu" class="nav">
      {SITE.navigation.map((item) => <a href={anchor(item.href)}>{item.label}</a>)}
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-dark-bg) 88%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(245, 241, 234, 0.1);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-height: var(--header-height);
  }

  .brand {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-dark-text);
    text-decoration: none;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .brand-mark-sub {
    font-weight: 500;
    letter-spacing: 0.22em;
    opacity: 0.88;
  }

  .brand:hover {
    color: var(--color-accent-bright);
  }

  .nav {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .nav a {
    color: var(--color-dark-text-muted);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 600;
    transition: color var(--transition);
  }

  .nav a:hover {
    color: var(--color-accent-bright);
  }

  .burger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    padding: var(--space-1);
    cursor: pointer;
  }

  .burger span {
    width: 24px;
    height: 2.5px;
    background: var(--color-dark-text);
    border-radius: 2px;
  }

  @media (max-width: 820px) {
    .burger {
      display: flex;
    }

    .nav {
      display: none;
      position: absolute;
      top: var(--header-height);
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      background: var(--color-dark-bg);
      border-bottom: 1px solid rgba(245, 241, 234, 0.12);
    }

    .nav.open {
      display: flex;
    }

    .nav a {
      padding: var(--space-2) var(--space-3);
      border-top: 1px solid rgba(245, 241, 234, 0.12);
    }
  }
</style>

<script>
  const burger = document.getElementById("menu-burger");
  const menu = document.getElementById("main-menu");

  burger?.addEventListener("click", () => {
    const open = menu?.classList.toggle("open");
    burger.setAttribute("aria-expanded", String(Boolean(open)));
  });

  menu?.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).tagName === "A") {
      menu.classList.remove("open");
      burger?.setAttribute("aria-expanded", "false");
    }
  });
</script>
