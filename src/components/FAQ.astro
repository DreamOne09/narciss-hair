---
import { site } from "../config/site";
const { faq } = site;
---

<section id="faq" class="bg-paper py-16 md:py-24" aria-labelledby="faq-title">
  <div class="mx-auto max-w-3xl px-4 md:px-8">
    <header class="reveal">
      <p class="text-[11px] tracking-[0.24em] text-accent uppercase">FAQ</p>
      <h2 id="faq-title" class="font-display mt-3 text-3xl font-semibold md:text-4xl">
        {faq.title}
      </h2>
    </header>

    <div class="reveal mt-10 divide-y divide-ink/10 border-y border-ink/10">
      {
        faq.items.map((item) => (
          <details class="group py-5">
            <summary class="cursor-pointer list-none pr-8 text-base font-medium text-ink marker:content-none [&::-webkit-details-marker]:hidden">
              <span class="flex items-start justify-between gap-4">
                {item.q}
                <span class="text-accent transition-transform group-open:rotate-45">+</span>
              </span>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-ink-muted">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
