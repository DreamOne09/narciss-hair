---
import { SITE } from "../../config/site";
import { asset } from "../../lib/paths";

const { gallery } = SITE;
const featured = gallery.featured;
const more = gallery.more;
---

<section id="gallery" class="section gallery-feature">
  <div class="container">
    {gallery.eyebrow && <p class="section-eyebrow">{gallery.eyebrow}</p>}
    <h2>{gallery.title}</h2>
    {"lead" in gallery && gallery.lead && <p class="gallery-lead">{gallery.lead}</p>}
    <div class="gallery-wall reveal">
      <div class="gallery-featured-row">
        {
          featured.map((image) => (
            <figure class="gallery-item">
              <div class="gallery-frame">
                <img
                  src={asset(image.src)}
                  alt={image.alt}
                  loading="lazy"
                  width="400"
                  height="300"
                  class="gallery-image"
                />
              </div>
              <span class="gallery-wm">{SITE.vi.imageWatermark}</span>
            </figure>
          ))
        }
      </div>
      <div class="gallery-more-grid">
        {
          more.map((image) => (
            <figure class="gallery-item gallery-item--secondary">
              <div class="gallery-frame">
                <img
                  src={asset(image.src)}
                  alt={image.alt}
                  loading="lazy"
                  width="400"
                  height="300"
                  class="gallery-image"
                />
              </div>
              <span class="gallery-wm">{SITE.vi.imageWatermark}</span>
            </figure>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .gallery-feature {
    padding-block: var(--space-section);
    padding-top: clamp(2.25rem, 5vw, 3.5rem);
    background: var(--color-parchment);
    margin-top: -1px;
  }

  .gallery-lead {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
    max-width: 36rem;
  }

  .gallery-wall {
    display: flex;
    flex-direction: column;
    gap: clamp(1.1rem, 4vw, 1.75rem);
  }

  .gallery-featured-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1rem, 3.5vw, 1.5rem);
  }

  @media (min-width: 768px) {
    .gallery-featured-row {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
  }

  .gallery-more-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1rem, 3.5vw, 1.25rem);
  }

  @media (min-width: 480px) {
    .gallery-more-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 768px) {
    .gallery-more-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.15rem;
    }
  }

  .gallery-item {
    margin: 0;
    position: relative;
  }

  .gallery-frame {
    padding: 0.55rem;
    background: var(--color-ivory);
    border: 1px solid var(--color-gold-line);
    box-shadow:
      inset 0 0 0 1px rgba(255, 248, 235, 0.65),
      0 6px 22px rgba(42, 31, 20, 0.08);
  }

  .gallery-item--secondary .gallery-frame {
    padding: 0.45rem;
  }

  .gallery-featured-row .gallery-image {
    aspect-ratio: 4 / 3;
    min-height: clamp(200px, 52vw, 340px);
  }

  .gallery-more-grid .gallery-image {
    aspect-ratio: 4 / 3;
    min-height: 180px;
  }

  .gallery-wm {
    position: absolute;
    left: 0.85rem;
    bottom: 0.65rem;
    z-index: 2;
    font-size: 0.58rem;
    letter-spacing: 0.06em;
    color: rgba(246, 241, 230, 0.92);
    background: rgba(42, 31, 20, 0.52);
    padding: 0.18rem 0.45rem;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(196, 162, 90, 0.25);
  }

  .gallery-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (min-width: 1440px) {
    .gallery-featured-row .gallery-image {
      min-height: 320px;
    }
  }
</style>
