---
import { SITE } from "../../config/site";
import { asset } from "../../lib/paths";

const { gallery } = SITE;
const featured = gallery.featured;
const more = gallery.more;
---

<section id="gallery" class="section gallery-feature">
  <div class="container">
    {gallery.eyebrow && <p class="section-eyebrow">{gallery.eyebrow}</p>}
    <h2>{gallery.title}</h2>
    {"lead" in gallery && gallery.lead && <p class="gallery-lead">{gallery.lead}</p>}
    <div class="gallery-wall reveal">
      <div class="gallery-featured-row">
        {
          featured.map((image) => (
            <figure class="gallery-item">
              <img
                src={asset(image.src)}
                alt={image.alt}
                loading="lazy"
                width="400"
                height="300"
                class="gallery-image"
              />
              <span class="gallery-wm">{SITE.vi.imageWatermark}</span>
            </figure>
          ))
        }
      </div>
      <div class="gallery-more-grid">
        {
          more.map((image) => (
            <figure class="gallery-item">
              <img
                src={asset(image.src)}
                alt={image.alt}
                loading="lazy"
                width="400"
                height="300"
                class="gallery-image"
              />
              <span class="gallery-wm">{SITE.vi.imageWatermark}</span>
            </figure>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .gallery-feature {
    padding-block: var(--space-section);
  }

  .gallery-lead {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
    max-width: 36rem;
  }

  .gallery-wall {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .gallery-featured-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.45rem;
  }

  .gallery-featured-row .gallery-item {
    min-height: clamp(160px, 38vw, 340px);
  }

  .gallery-more-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.45rem;
  }

  @media (min-width: 768px) {
    .gallery-more-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .gallery-more-grid .gallery-item {
    min-height: 160px;
  }

  .gallery-item {
    margin: 0;
    border-radius: var(--radius-sm);
    overflow: hidden;
    position: relative;
  }

  .gallery-wm {
    position: absolute;
    left: 0.45rem;
    bottom: 0.45rem;
    z-index: 2;
    font-size: 0.6rem;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.8);
    background: rgba(28, 27, 26, 0.5);
    padding: 0.15rem 0.4rem;
    border-radius: var(--radius-sm);
  }

  .gallery-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 420ms ease;
  }

  .gallery-item::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 62%, rgba(29, 20, 13, 0.5) 100%);
    opacity: 0;
    transition: opacity var(--transition);
  }

  @media (hover: hover) {
    .gallery-item:hover .gallery-image {
      transform: scale(1.05);
    }

    .gallery-item:hover::after {
      opacity: 1;
    }
  }

  @media (min-width: 1440px) {
    .gallery-wall {
      gap: 0.55rem;
    }

    .gallery-featured-row {
      gap: 0.55rem;
    }

    .gallery-featured-row .gallery-item {
      min-height: 360px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-item:hover .gallery-image {
      transform: none;
    }
  }
</style>
