---
import { SITE } from "../../config/site";
import { asset } from "../../lib/paths";

const { gallery } = SITE;
const featured = gallery.featured;
const more = gallery.more;
const zoneLabel = "zoneDemoLabel" in gallery ? gallery.zoneDemoLabel : SITE.vi.imageWatermark;
---

<section id="gallery" class="section gallery-feature">
  <div class="container">
    {gallery.eyebrow && <p class="section-eyebrow">{gallery.eyebrow}</p>}
    <h2>{gallery.title}</h2>
    {"lead" in gallery && gallery.lead && <p class="gallery-lead">{gallery.lead}</p>}
    <p class="gallery-zone-demo" role="note">{zoneLabel}</p>
    <div class="gallery-wall reveal">
      <div class="gallery-featured-row">
        {
          featured.map((image) => (
            <figure class:list={["gallery-item", image.aiDemo && "gallery-item--ai"]}>
              <div class="gallery-frame">
                <img
                  src={asset(image.src)}
                  alt={image.alt}
                  loading="lazy"
                  width="400"
                  height="300"
                  class="gallery-image"
                />
              </div>
              {image.aiDemo && <span class="gallery-ai-tag">Demo｜AI</span>}
            </figure>
          ))
        }
      </div>
      <div class="gallery-more-grid">
        {
          more.map((image) => (
            <figure class:list={["gallery-item gallery-item--secondary", image.aiDemo && "gallery-item--ai"]}>
              <div class="gallery-frame">
                <img
                  src={asset(image.src)}
                  alt={image.alt}
                  loading="lazy"
                  width="400"
                  height="300"
                  class="gallery-image"
                />
              </div>
              {image.aiDemo && <span class="gallery-ai-tag">Demo｜AI</span>}
            </figure>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .gallery-feature {
    padding-block: var(--space-section);
    padding-top: clamp(2.25rem, 5vw, 3.5rem);
    background: var(--color-parchment);
    margin-top: -1px;
  }

  .gallery-lead {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    margin-bottom: var(--space-1);
    max-width: 36rem;
  }

  .gallery-zone-demo {
    margin: 0 0 var(--space-3);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--color-label-muted);
    max-width: 40rem;
  }

  .gallery-wall {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: clamp(1.1rem, 4vw, 1.75rem);
  }

  .gallery-wall::after {
    content: "Demo";
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 14vw, 7rem);
    font-weight: 600;
    letter-spacing: 0.35em;
    color: color-mix(in srgb, var(--color-gold-foil) 7%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    transform: rotate(-12deg);
    user-select: none;
  }

  .gallery-featured-row,
  .gallery-more-grid {
    position: relative;
    z-index: 1;
  }

  .gallery-featured-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1rem, 3.5vw, 1.5rem);
  }

  @media (min-width: 768px) {
    .gallery-featured-row {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
  }

  .gallery-more-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1rem, 3.5vw, 1.25rem);
  }

  @media (min-width: 480px) {
    .gallery-more-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 768px) {
    .gallery-more-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.15rem;
    }
  }

  .gallery-item {
    margin: 0;
    position: relative;
  }

  .gallery-frame {
    padding: 0.55rem;
    background: var(--color-ivory);
    border: 1px solid var(--color-gold-line);
    box-shadow:
      inset 0 0 0 1px rgba(255, 248, 235, 0.55),
      0 6px 22px rgba(31, 27, 23, 0.06);
  }

  .gallery-item--secondary .gallery-frame {
    padding: 0.45rem;
  }

  .gallery-featured-row .gallery-image {
    aspect-ratio: 4 / 3;
    min-height: clamp(200px, 52vw, 340px);
  }

  .gallery-more-grid .gallery-image {
    aspect-ratio: 4 / 3;
    min-height: 180px;
  }

  .gallery-ai-tag {
    position: absolute;
    right: 0.75rem;
    top: 0.55rem;
    z-index: 2;
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--color-ivory);
    background: rgba(31, 27, 23, 0.62);
    padding: 0.2rem 0.45rem;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(168, 148, 112, 0.35);
  }

  .gallery-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (min-width: 1440px) {
    .gallery-featured-row .gallery-image {
      min-height: 320px;
    }
  }
</style>
