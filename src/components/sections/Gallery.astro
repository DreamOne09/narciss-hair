---
import { SITE } from "../../config/site";
import { asset } from "../../lib/paths";

const { gallery } = SITE;
const spreads = gallery.spreads;
const zoneLabel = "zoneDemoLabel" in gallery ? gallery.zoneDemoLabel : SITE.vi.imageWatermark;
---

<section id="gallery" class="section gallery-editorial">
  <div class="container gallery-head">
    {gallery.eyebrow && <p class="section-eyebrow">{gallery.eyebrow}</p>}
    <h2>{gallery.title}</h2>
    {"lead" in gallery && gallery.lead && <p class="gallery-lead">{gallery.lead}</p>}
    <p class="gallery-zone-demo" role="note">{zoneLabel}</p>
  </div>

  <div class="gallery-stream reveal">
    {
      spreads.map((block) =>
        block.layout === "spread" ? (
          <figure class:list={["gallery-spread", block.aiDemo && "gallery-spread--ai"]}>
            <img
              src={asset(block.src)}
              alt={block.alt}
              loading="lazy"
              width="1200"
              height="1500"
              class="gallery-image"
            />
            {block.aiDemo && <span class="gallery-ai-tag">Demo｜AI</span>}
          </figure>
        ) : (
          <div class="gallery-pair">
            {block.items.map((image) => (
              <figure class:list={["gallery-cell", image.aiDemo && "gallery-cell--ai"]}>
                <img
                  src={asset(image.src)}
                  alt={image.alt}
                  loading="lazy"
                  width="800"
                  height="1000"
                  class="gallery-image"
                />
                {image.aiDemo && <span class="gallery-ai-tag">Demo｜AI</span>}
              </figure>
            ))}
          </div>
        )
      )
    }
  </div>
</section>

<style>
  .gallery-editorial {
    padding-block: var(--space-section);
    padding-top: clamp(1.75rem, 4vw, 3rem);
    background: var(--color-parchment);
    margin-top: -1px;
  }

  .gallery-head {
    margin-bottom: clamp(1.25rem, 4vw, 2rem);
  }

  .gallery-head h2 {
    margin-bottom: 0.35rem;
  }

  .gallery-lead {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    margin-bottom: var(--space-1);
    max-width: 32rem;
  }

  .gallery-zone-demo {
    margin: 0;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--color-label-muted);
    max-width: 40rem;
  }

  .gallery-stream {
    display: flex;
    flex-direction: column;
    gap: clamp(0.65rem, 2.5vw, 1.15rem);
    padding-inline: var(--container-inline);
    max-width: var(--content-width);
    margin-inline: auto;
  }

  .gallery-spread,
  .gallery-cell {
    margin: 0;
    position: relative;
    overflow: hidden;
  }

  .gallery-spread .gallery-image {
    width: 100%;
    aspect-ratio: 4 / 5;
    min-height: clamp(260px, 72vw, 520px);
    object-fit: cover;
    display: block;
  }

  .gallery-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(0.65rem, 2.5vw, 1rem);
  }

  .gallery-cell .gallery-image {
    width: 100%;
    aspect-ratio: 3 / 4;
    min-height: clamp(200px, 42vw, 380px);
    object-fit: cover;
    display: block;
  }

  .gallery-ai-tag {
    position: absolute;
    left: 0.65rem;
    bottom: 0.65rem;
    z-index: 2;
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--color-ivory);
    background: rgba(31, 27, 23, 0.62);
    padding: 0.2rem 0.45rem;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(168, 148, 112, 0.35);
  }

  @media (min-width: 768px) {
    .gallery-stream {
      gap: 1.25rem;
      padding-inline: clamp(var(--container-inline), 4vw, 2.5rem);
    }

    .gallery-spread .gallery-image {
      aspect-ratio: 16 / 9;
      min-height: clamp(320px, 42vw, 560px);
    }

    .gallery-pair {
      gap: 1.25rem;
    }

    .gallery-cell .gallery-image {
      min-height: clamp(280px, 28vw, 420px);
    }
  }

  @media (min-width: 1280px) {
    .gallery-spread .gallery-image {
      min-height: 520px;
    }
  }
</style>
