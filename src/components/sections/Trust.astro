---
import { SITE } from "../../config/site";

const { trust } = SITE;
---

<section id="trust" class="section section-alt">
  <div class="container">
    {trust.eyebrow && <p class="section-eyebrow">{trust.eyebrow}</p>}
    <h2>{trust.title}</h2>
    <p class="intro">{trust.intro}</p>

    <div class="trust-actions reveal">
      {
        trust.actions.map((action) => (
          <a
            class:list={["button", action.variant === "secondary" && "button-secondary"]}
            href={action.href}
            target="_blank"
            rel="noopener noreferrer"
          >
            {action.label}
          </a>
        ))
      }
    </div>

    <ul class="trust-list">
      {
        trust.items.map((item) => (
          <li class="trust-item reveal">
            <p class="trust-item-title">{item.title}</p>
            <p class="trust-item-body">{item.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .intro {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    margin-bottom: var(--space-3);
    max-width: 40rem;
  }

  .trust-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.55rem;
    margin-bottom: var(--space-4);
  }

  @media (min-width: 480px) {
    .trust-actions {
      display: flex;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.65rem;
    }
  }

  .trust-actions .button {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    font-size: var(--text-sm);
    padding-inline: 1rem;
  }

  @media (min-width: 480px) {
    .trust-actions .button {
      width: auto;
      font-size: var(--text-base);
    }
  }

  .trust-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }

  @media (min-width: 768px) {
    .trust-list {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-4);
    }
  }

  .trust-item {
    margin: 0;
    padding: var(--space-2) 0 var(--space-2) var(--space-2);
    border-left: 3px solid var(--color-copper-bright);
  }

  .trust-item-title {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 600;
    margin: 0 0 0.35rem;
    letter-spacing: 0.02em;
  }

  .trust-item-body {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0;
    max-width: 28rem;
    line-height: 1.7;
  }
</style>
