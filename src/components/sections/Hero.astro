---
import { SITE } from "../../config/site";
import { asset } from "../../lib/paths";

const { hero, vi } = SITE;
const heroImage = asset(hero.image);
---

<section class="hero-immersive" aria-labelledby="hero-title">
  <img
    src={heroImage}
    alt={hero.imageAlt}
    class="hero-backdrop"
    width="1920"
    height="1280"
    fetchpriority="high"
    decoding="async"
  />
  <span class="hero-watermark" aria-hidden="true">{vi.imageWatermark}</span>

  <div class="container hero-stage">
    <div class="hero-text">
      {hero.eyebrow && <p class="hero-eyebrow hero-canvas-layer">{hero.eyebrow}</p>}
      <h1 id="hero-title" class="hero-canvas-layer">{hero.title}</h1>
      <p class="hero-oneline hero-canvas-layer">{hero.subtitle}</p>

      <div class="hero-actions hero-canvas-cta">
        <a
          class="button hero-primary-cta"
          href={hero.primaryCta.href}
          target="_blank"
          rel="noopener noreferrer"
          data-cta="line"
        >
          {hero.primaryCta.label}
        </a>
      </div>
    </div>
  </div>

  <div class="hero-bottom-feather" aria-hidden="true"></div>
</section>

<style>
  .hero-immersive {
    position: relative;
    min-height: calc(100dvh - var(--site-chrome));
    max-height: none;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-bottom: clamp(1.5rem, 6vw, 3.25rem);
    color: var(--color-dark-text);
    overflow: hidden;
    isolation: isolate;
    padding-block: 0;
  }

  .hero-backdrop {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -3;
    -webkit-mask-image: linear-gradient(
      to bottom,
      #000 0%,
      #000 72%,
      rgba(0, 0, 0, 0.55) 88%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      #000 0%,
      #000 72%,
      rgba(0, 0, 0, 0.55) 88%,
      transparent 100%
    );
  }

  /* 卡拉瓦喬式單側強光：髮／作品亮、周邊深褐沉 */
  .hero-immersive::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(
        ellipse 78% 62% at 68% 38%,
        rgba(244, 241, 234, 0.18) 0%,
        rgba(61, 52, 40, 0.06) 42%,
        transparent 68%
      ),
      linear-gradient(180deg, rgba(18, 17, 15, 0.55) 0%, rgba(31, 27, 23, 0.12) 42%, rgba(18, 17, 15, 0.82) 100%),
      var(--gradient-chiaroscuro);
  }

  .hero-immersive::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(90deg, rgba(26, 20, 16, 0.55) 0%, transparent 42%);
  }

  .hero-watermark {
    position: absolute;
    right: var(--container-inline);
    bottom: clamp(4.5rem, 12vw, 6rem);
    z-index: 2;
    font-size: 0.58rem;
    letter-spacing: 0.06em;
    color: rgba(244, 241, 234, 0.38);
    writing-mode: vertical-rl;
    pointer-events: none;
  }

  .hero-stage {
    padding: clamp(2rem, 8vh, 4rem) var(--container-inline) var(--space-2);
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: var(--content-width);
    margin-inline: auto;
  }

  .hero-text {
    max-width: 28rem;
  }

  .hero-eyebrow {
    margin: 0 0 0.65rem;
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-copper-bright);
  }

  .hero-immersive h1 {
    color: var(--color-dark-text);
    margin-bottom: 0.35rem;
    font-size: clamp(1.85rem, 7.4vw, 3.35rem);
    font-weight: 700;
    letter-spacing: var(--tracking-display);
    text-shadow: 0 2px 28px rgba(26, 20, 16, 0.55);
  }

  .hero-oneline {
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.05em;
    color: var(--color-dark-text-muted);
    max-width: 20rem;
    margin-bottom: clamp(1.25rem, 4vw, 2rem);
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.35);
  }

  .hero-actions {
    display: flex;
    align-items: stretch;
  }

  .hero-actions .hero-primary-cta {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    width: 100%;
    max-width: 16rem;
    padding-inline: 1.25rem;
    font-size: var(--text-base);
    color: var(--color-ivory);
    background: color-mix(in srgb, var(--color-umber) 72%, transparent);
    border: 1px solid var(--color-gold-line);
    border-radius: var(--radius-sm);
    box-shadow:
      inset 0 1px 0 rgba(255, 248, 235, 0.14),
      inset 0 -2px 8px rgba(0, 0, 0, 0.35);
  }

  @media (min-width: 480px) {
    .hero-actions .hero-primary-cta {
      width: auto;
      min-width: 10.5rem;
    }
  }

  .hero-actions .hero-primary-cta:hover {
    color: var(--color-ivory);
    border-color: var(--color-copper-bright);
    background: color-mix(in srgb, var(--color-ochre-deep) 78%, transparent);
  }

  .hero-bottom-feather {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    pointer-events: none;
    height: clamp(3.25rem, 14vw, 4.75rem);
    background: linear-gradient(
      to bottom,
      transparent 0%,
      color-mix(in srgb, var(--color-parchment) 22%, transparent) 38%,
      color-mix(in srgb, var(--color-parchment) 88%, var(--color-umber) 12%) 100%
    );
  }

  @media (min-width: 768px) {
    .hero-backdrop {
      -webkit-mask-image: linear-gradient(
        to bottom,
        #000 0%,
        #000 76%,
        rgba(0, 0, 0, 0.5) 90%,
        transparent 100%
      );
      mask-image: linear-gradient(
        to bottom,
        #000 0%,
        #000 76%,
        rgba(0, 0, 0, 0.5) 90%,
        transparent 100%
      );
    }

    .hero-bottom-feather {
      height: clamp(3.5rem, 10vw, 5.25rem);
    }
  }

  @media (min-width: 1440px) {
    .hero-backdrop {
      -webkit-mask-image: linear-gradient(
        to bottom,
        #000 0%,
        #000 78%,
        rgba(0, 0, 0, 0.48) 91%,
        transparent 100%
      );
      mask-image: linear-gradient(
        to bottom,
        #000 0%,
        #000 78%,
        rgba(0, 0, 0, 0.48) 91%,
        transparent 100%
      );
    }

    .hero-bottom-feather {
      height: 5.5rem;
    }
  }

  @media (max-width: 479px) {
    .hero-immersive h1 {
      font-size: clamp(1.65rem, 6.8vw, 2rem);
    }
  }

  @media (min-width: 1440px) {
    .hero-immersive {
      min-height: min(calc(100dvh - var(--site-chrome)), 920px);
    }

    .hero-stage {
      padding-bottom: calc(var(--space-section) * 0.85);
    }
  }
</style>
