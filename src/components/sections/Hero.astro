---
import { SITE } from "../../config/site";
import { asset } from "../../lib/paths";

const { hero, demo, vi } = SITE;
const heroImage = asset(hero.image);
---

<section class="hero-immersive" aria-labelledby="hero-title">
  <img
    src={heroImage}
    alt={hero.imageAlt}
    class="hero-backdrop"
    width="1920"
    height="1280"
    fetchpriority="high"
    decoding="async"
  />
  <span class="hero-watermark" aria-hidden="true">{vi.imageWatermark}</span>

  <div class="container hero-stage">
    <div class="hero-text">
      <div class="hero-topline">
        <p class="hero-wordmark" aria-label="NARCISS HAIR">
          <span class="wm-narciss">NARCISS</span>
          <span class="wm-hair">HAIR</span>
        </p>
        <span class="demo-badge">{demo.ribbon}</span>
      </div>
      <h1 id="hero-title">{hero.title}</h1>
      <p class="hero-oneline">{hero.subtitle}</p>

      <div class="hero-actions">
        <a class="button" href={hero.primaryCta.href} data-cta="tel">
          {hero.primaryCta.label}
        </a>
        <a
          class="button button-hero-alt"
          href={hero.secondaryCta.href}
          target="_blank"
          rel="noopener noreferrer"
          data-cta="line"
        >
          {hero.secondaryCta.label}
        </a>
        <a
          class="button button-hero-ghost"
          href={hero.tertiaryCta.href}
          target="_blank"
          rel="noopener noreferrer"
          data-cta="ig"
        >
          {hero.tertiaryCta.label}
        </a>
      </div>
    </div>
  </div>

  <svg class="hero-ridge" viewBox="0 0 1440 70" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 70V38L180 12l150 22 190-30 170 26 160-14 210 22 180-28 200 24V70z" />
  </svg>
</section>

<style>
  .hero-immersive {
    position: relative;
    min-height: 100dvh;
    max-height: 920px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    color: var(--color-dark-text);
    overflow: hidden;
    isolation: isolate;
    padding-block: 0;
  }

  .hero-backdrop {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -3;
  }

  .hero-immersive::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      linear-gradient(180deg, rgba(15, 20, 25, 0.5) 0%, rgba(15, 20, 25, 0.2) 38%, rgba(15, 20, 25, 0.82) 100%),
      linear-gradient(105deg, rgba(15, 20, 25, 0.9) 0%, rgba(15, 20, 25, 0.45) 48%, rgba(15, 20, 25, 0.15) 100%);
  }

  .hero-watermark {
    position: absolute;
    right: var(--space-2);
    bottom: 5rem;
    z-index: 2;
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    color: rgba(245, 241, 234, 0.5);
    writing-mode: vertical-rl;
  }

  .hero-stage {
    padding: calc(70px + var(--space-3)) var(--space-3) var(--space-section);
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: var(--content-width);
    margin-inline: auto;
  }

  .hero-text {
    max-width: 34rem;
  }

  .hero-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-bottom: var(--space-2);
  }

  .hero-wordmark {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    line-height: 1;
  }

  .wm-narciss {
    font-family: var(--font-display);
    font-size: 0.95rem;
    letter-spacing: 0.28em;
    font-weight: 600;
    color: var(--color-dark-text);
  }

  .wm-hair {
    font-family: var(--font-display);
    font-size: 0.72rem;
    letter-spacing: 0.42em;
    font-weight: 500;
    color: var(--color-dark-text-muted);
  }

  .demo-badge {
    font-size: 0.65rem;
    border: 1px solid rgba(245, 241, 234, 0.28);
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-pill);
    color: var(--color-dark-text-muted);
  }

  .hero-immersive h1 {
    color: var(--color-dark-text);
    margin-bottom: 0.35rem;
    font-size: clamp(1.85rem, 8vw, 3.25rem);
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.35);
  }

  .hero-oneline {
    font-size: var(--text-base);
    color: var(--color-dark-text);
    max-width: 22rem;
    margin-bottom: var(--space-3);
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.4);
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  @media (min-width: 480px) {
    .hero-actions {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: stretch;
    }
  }

  .hero-actions .button {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-width: 9.5rem;
    color: var(--color-on-accent);
  }

  .hero-actions .button:hover {
    color: var(--color-on-accent);
  }

  .button-hero-alt {
    background: var(--gradient-accent);
    box-shadow: var(--shadow-glow);
    border: none;
  }

  .button-hero-ghost {
    background: transparent;
    border: 2px solid rgba(184, 146, 90, 0.55);
    color: var(--color-dark-text);
    box-shadow: none;
    font-size: var(--text-sm);
    min-width: auto;
    padding-inline: 1.25rem;
  }

  .button-hero-ghost:hover {
    background: rgba(168, 137, 92, 0.2);
    color: var(--color-dark-text);
  }

  .hero-ridge {
    display: block;
    width: 100%;
    height: 70px;
    margin-top: -1px;
    position: relative;
    z-index: 1;
  }

  .hero-ridge path {
    fill: var(--color-bg);
  }

  @media (min-width: 1440px) {
    .hero-immersive {
      max-height: none;
      min-height: min(92vh, 980px);
    }

    .hero-stage {
      padding-bottom: calc(var(--space-section) * 1.15);
    }
  }
</style>
