---
import { SITE } from "../../config/site";
import { asset } from "../../lib/paths";

const { hero, vi } = SITE;
const heroImage = asset(hero.image);
---

<section class="hero-immersive" aria-labelledby="hero-title">
  <img
    src={heroImage}
    alt={hero.imageAlt}
    class="hero-backdrop"
    width="1920"
    height="1280"
    fetchpriority="high"
    decoding="async"
  />
  <span class="hero-watermark" aria-hidden="true">{vi.imageWatermark}</span>

  <div class="container hero-stage">
    <div class="hero-text">
      <h1 id="hero-title">{hero.title}</h1>
      <p class="hero-oneline">{hero.subtitle}</p>

      <div class="hero-actions">
        <a class="button" href={hero.primaryCta.href} data-cta="tel">
          {hero.primaryCta.label}
        </a>
        <a
          class="button button-hero-alt"
          href={hero.secondaryCta.href}
          target="_blank"
          rel="noopener noreferrer"
          data-cta="line"
        >
          {hero.secondaryCta.label}
        </a>
        <a
          class="button button-hero-ghost"
          href={hero.tertiaryCta.href}
          target="_blank"
          rel="noopener noreferrer"
          data-cta="ig"
        >
          {hero.tertiaryCta.label}
        </a>
      </div>
    </div>
  </div>

  <svg class="hero-ridge" viewBox="0 0 1440 70" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 70V38L180 12l150 22 190-30 170 26 160-14 210 22 180-28 200 24V70z" />
  </svg>
</section>

<style>
  .hero-immersive {
    position: relative;
    min-height: calc(100dvh - var(--site-chrome));
    max-height: none;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    color: var(--color-dark-text);
    overflow: hidden;
    isolation: isolate;
    padding-block: 0;
  }

  .hero-backdrop {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -3;
  }

  .hero-immersive::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      linear-gradient(180deg, rgba(15, 20, 25, 0.5) 0%, rgba(15, 20, 25, 0.2) 38%, rgba(15, 20, 25, 0.82) 100%),
      linear-gradient(105deg, rgba(15, 20, 25, 0.9) 0%, rgba(15, 20, 25, 0.45) 48%, rgba(15, 20, 25, 0.15) 100%);
  }

  .hero-watermark {
    display: none;
  }

  @media (min-width: 768px) {
    .hero-watermark {
      display: block;
      position: absolute;
      right: var(--space-2);
      bottom: 5rem;
      z-index: 2;
      font-size: 0.62rem;
      letter-spacing: 0.08em;
      color: rgba(245, 241, 234, 0.45);
      writing-mode: vertical-rl;
    }
  }

  .hero-stage {
    padding: var(--space-1) var(--container-inline) var(--space-2);
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: var(--content-width);
    margin-inline: auto;
  }

  .hero-text {
    max-width: 32rem;
  }

  .hero-immersive h1 {
    color: var(--color-dark-text);
    margin-bottom: 0.25rem;
    font-size: clamp(1.72rem, 7.2vw, 3.25rem);
    letter-spacing: 0.02em;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.35);
  }

  .hero-oneline {
    font-size: var(--text-base);
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--color-dark-text);
    max-width: 14rem;
    margin-bottom: var(--space-2);
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.4);
  }

  .hero-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.55rem;
    align-items: stretch;
  }

  .hero-actions .button-hero-ghost {
    grid-column: 1 / -1;
    min-height: 44px;
  }

  @media (min-width: 480px) {
    .hero-oneline {
      margin-bottom: var(--space-2);
    }

    .hero-actions {
      display: flex;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.65rem;
    }

    .hero-actions .button-hero-ghost {
      grid-column: auto;
    }
  }

  .hero-actions .button {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-width: 0;
    width: 100%;
    padding-inline: 1rem;
    font-size: var(--text-sm);
    color: var(--color-on-accent);
  }

  @media (min-width: 480px) {
    .hero-actions .button {
      min-width: 9.5rem;
      width: auto;
      font-size: var(--text-base);
    }
  }

  .hero-actions .button:hover {
    color: var(--color-on-accent);
  }

  .button-hero-alt {
    background: var(--gradient-accent);
    box-shadow: var(--shadow-glow);
    border: none;
  }

  .button-hero-ghost {
    background: transparent;
    border: 2px solid rgba(184, 146, 90, 0.55);
    color: var(--color-dark-text);
    box-shadow: none;
    font-size: var(--text-sm);
    min-width: auto;
    padding-inline: 1.25rem;
  }

  .button-hero-ghost:hover {
    background: rgba(168, 137, 92, 0.2);
    color: var(--color-dark-text);
  }

  .hero-ridge {
    display: block;
    width: 100%;
    height: 70px;
    margin-top: -1px;
    position: relative;
    z-index: 1;
  }

  .hero-ridge path {
    fill: var(--color-bg);
  }

  @media (max-width: 479px) {
    .hero-immersive h1 {
      font-size: clamp(1.65rem, 6.8vw, 2rem);
    }
  }

  @media (min-width: 1440px) {
    .hero-immersive {
      min-height: min(calc(100dvh - var(--site-chrome)), 920px);
    }

    .hero-stage {
      padding-bottom: calc(var(--space-section) * 0.85);
    }
  }
</style>
