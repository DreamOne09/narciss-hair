---
import { SITE } from "../../config/site";
import { asset } from "../../lib/paths";

const { hero, vi, business } = SITE;
const heroImage = asset(hero.image);
const telHref = `tel:${business.phone}`;
---

<section class="hero-immersive" aria-labelledby="hero-title">
  <img
    src={heroImage}
    alt={hero.imageAlt}
    class="hero-backdrop"
    width="1920"
    height="1280"
    fetchpriority="high"
    decoding="async"
  />
  <span class="hero-watermark" aria-hidden="true">{vi.imageWatermark}</span>

  <div class="container hero-stage">
    <div class="hero-text">
      {hero.eyebrow && <p class="hero-eyebrow hero-canvas-layer">{hero.eyebrow}</p>}
      <h1 id="hero-title" class="hero-canvas-layer">{hero.title}</h1>
      {hero.subtitle && <p class="hero-oneline hero-canvas-layer">{hero.subtitle}</p>}

      <div class="hero-actions hero-canvas-cta">
        <a class="button hero-cta" href={telHref} data-cta="tel">
          {hero.primaryCta.label}
        </a>
        <a
          class="button button-secondary hero-cta hero-cta--ig"
          href={hero.secondaryCta.href}
          target="_blank"
          rel="noopener noreferrer"
          data-cta="ig"
        >
          {hero.secondaryCta.label}
        </a>
      </div>
    </div>
  </div>

  <div class="hero-bottom-feather" aria-hidden="true"></div>
</section>

<style>
  .hero-immersive {
    position: relative;
    min-height: calc(100dvh - var(--site-chrome));
    max-height: calc(100dvh - var(--site-chrome));
    max-height: none;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    color: var(--color-dark-text);
    overflow: hidden;
    isolation: isolate;
    padding-block: 0;
  }

  .hero-backdrop {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 22%;
    z-index: -3;
    -webkit-mask-image: linear-gradient(
      to bottom,
      #000 0%,
      #000 58%,
      rgba(0, 0, 0, 0.72) 78%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      #000 0%,
      #000 58%,
      rgba(0, 0, 0, 0.72) 78%,
      transparent 100%
    );
  }

  .hero-immersive::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -2;
    background: linear-gradient(
      180deg,
      rgba(18, 17, 15, 0.12) 0%,
      rgba(18, 17, 15, 0.05) 45%,
      rgba(18, 17, 15, 0.72) 100%
    );
  }

  .hero-immersive::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(90deg, rgba(26, 20, 16, 0.35) 0%, transparent 55%);
  }

  .hero-watermark {
    position: absolute;
    right: var(--container-inline);
    bottom: clamp(5rem, 14vw, 7rem);
    z-index: 2;
    font-size: 0.58rem;
    letter-spacing: 0.06em;
    color: rgba(244, 241, 234, 0.38);
    writing-mode: vertical-rl;
    pointer-events: none;
  }

  .hero-stage {
    padding: clamp(0.75rem, 3vh, 2.5rem) var(--container-inline) 0.65rem;
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: var(--content-width);
    margin-inline: auto;
  }

  .hero-text {
    max-width: 26rem;
  }

  .hero-eyebrow {
    margin: 0 0 0.45rem;
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-copper-bright);
  }

  .hero-immersive h1 {
    color: var(--color-dark-text);
    margin-bottom: 0.25rem;
    font-size: clamp(1.75rem, 7vw, 3.1rem);
    font-weight: 700;
    letter-spacing: var(--tracking-display);
    text-shadow: 0 2px 24px rgba(26, 20, 16, 0.45);
  }

  .hero-oneline {
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--color-dark-text-muted);
    max-width: 18rem;
    margin-bottom: 0.85rem;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.35);
  }

  .hero-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
    align-items: stretch;
    max-width: 20rem;
  }

  .hero-actions .hero-cta {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    width: 100%;
    padding-inline: 0.75rem;
    font-size: var(--text-sm);
  }

  .hero-actions .hero-cta--ig {
    color: var(--color-ivory);
    background: color-mix(in srgb, var(--color-umber) 55%, transparent);
    border-color: var(--color-gold-line);
  }

  .hero-actions .hero-cta--ig:hover {
    color: var(--color-ivory);
    background: color-mix(in srgb, var(--color-ochre-deep) 65%, transparent);
  }

  .hero-bottom-feather {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    pointer-events: none;
    height: clamp(2.5rem, 10vw, 4rem);
    background: linear-gradient(
      to bottom,
      transparent 0%,
      color-mix(in srgb, var(--color-parchment) 75%, transparent) 100%
    );
  }

  @media (max-width: 479px) {
    .hero-immersive {
      overflow: hidden;
      justify-content: flex-end;
    }

    .hero-stage {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      padding-bottom: 0.5rem;
    }

    .hero-oneline,
    .hero-eyebrow {
      display: none;
    }

    .hero-immersive h1 {
      font-size: clamp(1.55rem, 6.4vw, 1.85rem);
      margin-bottom: 0.5rem;
    }

    .hero-actions .hero-cta {
      min-height: 44px;
      padding-block: 0.55rem;
      font-size: 0.8rem;
    }
  }

  @media (min-width: 768px) {
    .hero-immersive {
      min-height: calc(100dvh - var(--site-chrome));
      max-height: none;
    }

    .hero-backdrop {
      object-position: center 30%;
      -webkit-mask-image: linear-gradient(
        to bottom,
        #000 0%,
        #000 68%,
        rgba(0, 0, 0, 0.55) 88%,
        transparent 100%
      );
      mask-image: linear-gradient(
        to bottom,
        #000 0%,
        #000 68%,
        rgba(0, 0, 0, 0.55) 88%,
        transparent 100%
      );
    }

    .hero-oneline {
      margin-bottom: clamp(1rem, 3vw, 1.5rem);
    }

    .hero-actions {
      max-width: none;
      display: flex;
      flex-wrap: wrap;
      gap: 0.65rem;
    }

    .hero-actions .hero-cta {
      width: auto;
      min-width: 9.5rem;
      font-size: var(--text-base);
    }
  }

  @media (min-width: 1280px) {
    .hero-immersive {
      min-height: min(calc(100dvh - var(--site-chrome)), 920px);
    }

    .hero-stage {
      padding-bottom: calc(var(--space-section) * 0.75);
    }
  }
</style>
