---
import { SITE } from "../../config/site";
import { asset } from "../../lib/paths";

const { hero, vi } = SITE;
const heroImage = asset(hero.image);
---

<section class="hero-immersive" aria-labelledby="hero-title">
  <img
    src={heroImage}
    alt={hero.imageAlt}
    class="hero-backdrop"
    width="1920"
    height="1280"
    fetchpriority="high"
    decoding="async"
  />
  <span class="hero-watermark" aria-hidden="true">{vi.imageWatermark}</span>

  <div class="container hero-stage">
    <div class="hero-text">
      {hero.eyebrow && <p class="hero-eyebrow hero-canvas-layer">{hero.eyebrow}</p>}
      <h1 id="hero-title" class="hero-canvas-layer">{hero.title}</h1>
      <p class="hero-oneline hero-canvas-layer">{hero.subtitle}</p>

      <div class="hero-actions hero-canvas-cta">
        <a class="button" href={hero.primaryCta.href} data-cta="tel">
          {hero.primaryCta.label}
        </a>
        <a
          class="button button-hero-alt"
          href={hero.secondaryCta.href}
          target="_blank"
          rel="noopener noreferrer"
          data-cta="line"
        >
          {hero.secondaryCta.label}
        </a>
        <a
          class="button button-hero-ghost"
          href={hero.tertiaryCta.href}
          target="_blank"
          rel="noopener noreferrer"
          data-cta="ig"
        >
          {hero.tertiaryCta.label}
        </a>
      </div>
    </div>
  </div>

  <svg class="hero-ridge" viewBox="0 0 1440 70" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 70V38L180 12l150 22 190-30 170 26 160-14 210 22 180-28 200 24V70z" />
  </svg>
</section>

<style>
  .hero-immersive {
    position: relative;
    min-height: calc(100dvh - var(--site-chrome));
    max-height: none;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    color: var(--color-dark-text);
    overflow: hidden;
    isolation: isolate;
    padding-block: 0;
  }

  .hero-backdrop {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -3;
  }

  /* 卡拉瓦喬式單側強光：髮／作品亮、周邊深褐沉 */
  .hero-immersive::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(
        ellipse 85% 70% at 72% 42%,
        rgba(246, 241, 230, 0.22) 0%,
        rgba(74, 50, 36, 0.08) 42%,
        transparent 68%
      ),
      linear-gradient(180deg, rgba(26, 20, 16, 0.72) 0%, rgba(42, 31, 20, 0.18) 40%, rgba(26, 20, 16, 0.88) 100%),
      var(--gradient-chiaroscuro);
  }

  .hero-immersive::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(90deg, rgba(26, 20, 16, 0.55) 0%, transparent 42%);
  }

  .hero-watermark {
    display: none;
  }

  @media (min-width: 768px) {
    .hero-watermark {
      display: block;
      position: absolute;
      right: var(--space-2);
      bottom: 5rem;
      z-index: 2;
      font-size: 0.62rem;
      letter-spacing: 0.08em;
      color: rgba(245, 241, 234, 0.45);
      writing-mode: vertical-rl;
    }
  }

  .hero-stage {
    padding: var(--space-1) var(--container-inline) var(--space-2);
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: var(--content-width);
    margin-inline: auto;
  }

  .hero-text {
    max-width: 32rem;
  }

  .hero-eyebrow {
    margin: 0 0 0.65rem;
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-copper-bright);
  }

  .hero-immersive h1 {
    color: var(--color-dark-text);
    margin-bottom: 0.35rem;
    font-size: clamp(1.85rem, 7.4vw, 3.35rem);
    font-weight: 700;
    letter-spacing: var(--tracking-display);
    text-shadow: 0 2px 28px rgba(26, 20, 16, 0.55);
  }

  .hero-oneline {
    font-size: var(--text-base);
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--color-dark-text);
    max-width: 14rem;
    margin-bottom: var(--space-2);
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.4);
  }

  .hero-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.55rem;
    align-items: stretch;
  }

  .hero-actions .button-hero-ghost {
    grid-column: 1 / -1;
    min-height: 44px;
  }

  @media (min-width: 480px) {
    .hero-oneline {
      margin-bottom: var(--space-2);
    }

    .hero-actions {
      display: flex;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.65rem;
    }

    .hero-actions .button-hero-ghost {
      grid-column: auto;
    }
  }

  .hero-actions .button {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-width: 0;
    width: 100%;
    padding-inline: 1rem;
    font-size: var(--text-sm);
    color: var(--color-ivory);
    background: color-mix(in srgb, var(--color-umber) 72%, transparent);
    border: 1px solid var(--color-gold-line);
    border-radius: var(--radius-sm);
    box-shadow:
      inset 0 1px 0 rgba(255, 248, 235, 0.14),
      inset 0 -2px 8px rgba(0, 0, 0, 0.35);
  }

  @media (min-width: 480px) {
    .hero-actions .button {
      min-width: 9.5rem;
      width: auto;
      font-size: var(--text-base);
    }
  }

  .hero-actions .button:hover {
    color: var(--color-ivory);
    border-color: var(--color-copper-bright);
    background: color-mix(in srgb, var(--color-ochre-deep) 78%, transparent);
  }

  .button-hero-alt {
    background: color-mix(in srgb, var(--color-umber) 68%, transparent);
    box-shadow:
      inset 0 1px 0 rgba(255, 248, 235, 0.12),
      inset 0 -2px 8px rgba(0, 0, 0, 0.32);
    border: 1px solid var(--color-gold-line);
  }

  .button-hero-ghost {
    background: transparent;
    border: 1px solid rgba(196, 162, 90, 0.45);
    color: var(--color-dark-text);
    box-shadow: inset 0 1px 0 rgba(255, 248, 235, 0.08);
    font-size: var(--text-sm);
    min-width: auto;
    padding-inline: 1.25rem;
  }

  .button-hero-ghost:hover {
    background: color-mix(in srgb, var(--color-gold-foil) 14%, transparent);
    color: var(--color-dark-text);
  }

  .hero-ridge {
    display: block;
    width: 100%;
    height: 70px;
    margin-top: -1px;
    position: relative;
    z-index: 1;
  }

  .hero-ridge path {
    fill: var(--color-bg);
  }

  @media (max-width: 479px) {
    .hero-immersive h1 {
      font-size: clamp(1.65rem, 6.8vw, 2rem);
    }
  }

  @media (min-width: 1440px) {
    .hero-immersive {
      min-height: min(calc(100dvh - var(--site-chrome)), 920px);
    }

    .hero-stage {
      padding-bottom: calc(var(--space-section) * 0.85);
    }
  }
</style>
