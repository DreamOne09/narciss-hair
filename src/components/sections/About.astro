---
import { SITE } from "../../config/site";
import { asset } from "../../lib/paths";

const { about } = SITE;
---

<section id="about" class="section about-editorial">
  <div class="container about-stack reveal">
    <figure class="about-figure">
      <img
        src={asset(about.image)}
        alt={about.imageAlt}
        class="about-image"
        width="1200"
        height="800"
        loading="lazy"
      />
    </figure>
    <div class="about-text">
      {about.eyebrow && <p class="section-eyebrow">{about.eyebrow}</p>}
      <h2>{about.title}</h2>
      {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
</section>

<style>
  .about-editorial {
    padding-block: var(--space-section);
    background: var(--color-surface);
  }

  .about-stack {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 4vw, 2.5rem);
  }

  .about-figure {
    margin: 0;
  }

  .about-image {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    display: block;
  }

  .about-text h2 {
    margin-bottom: var(--space-2);
  }

  .about-text p {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: 1.75;
    max-width: 36rem;
  }

  .about-text p:last-child {
    margin-bottom: 0;
  }

  @media (min-width: 768px) {
    .about-stack {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: clamp(2rem, 5vw, 4rem);
      align-items: start;
    }

    .about-image {
      aspect-ratio: 4 / 5;
      min-height: 360px;
    }
  }

  @media (min-width: 1280px) {
    .about-image {
      min-height: 440px;
    }
  }
</style>
