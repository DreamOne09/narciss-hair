---
import { SITE } from "../../config/site";
import { asset } from "../../lib/paths";

const { services } = SITE;
---

<section id="services" class="section services-editorial">
  <div class="container services-intro">
    {services.eyebrow && <p class="section-eyebrow">{services.eyebrow}</p>}
    <h2>{services.title}</h2>
    <p class="intro">{services.intro}</p>
  </div>

  <div class="services-rows reveal">
    {
      services.items.map((item, index) => (
        <article class:list={["service-row", index % 2 === 1 && "service-row--reverse"]}>
          <figure class="service-figure">
            <img
              src={asset(item.image)}
              alt={item.imageAlt}
              loading="lazy"
              width="720"
              height="540"
              class="service-image"
            />
          </figure>
          <div class="service-copy">
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .services-editorial {
    padding-block: var(--space-section);
    background: var(--color-surface-alt);
  }

  .services-intro {
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }

  .intro {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    margin-bottom: 0;
    max-width: 36rem;
  }

  .services-rows {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 6vw, 3.5rem);
  }

  .service-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2);
    align-items: center;
    max-width: var(--content-width);
    margin-inline: auto;
    padding-inline: var(--container-inline);
  }

  .service-figure {
    margin: 0;
  }

  .service-image {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }

  .service-copy h3 {
    font-size: clamp(1.1rem, 3.5vw, 1.35rem);
    margin-bottom: 0.4rem;
  }

  .service-copy p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    max-width: 28rem;
    line-height: 1.75;
  }

  @media (min-width: 768px) {
    .service-row {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: clamp(1.5rem, 4vw, 3rem);
    }

    .service-row--reverse .service-figure {
      order: 2;
    }

    .service-row--reverse .service-copy {
      order: 1;
    }

    .service-image {
      aspect-ratio: 5 / 4;
      min-height: 240px;
    }
  }

  @media (min-width: 1280px) {
    .service-image {
      min-height: 280px;
    }
  }
</style>
