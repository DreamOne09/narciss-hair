---
import { SITE } from "../../config/site";

const { services } = SITE;
---

<section id="services" class="section section-compact">
  <div class="container">
    {services.eyebrow && <p class="section-eyebrow">{services.eyebrow}</p>}
    <h2>{services.title}</h2>
    <p class="intro">{services.intro}</p>

    <ul class="service-list reveal">
      {
        services.items.map((item) => (
          <li>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .section-compact {
    padding-block: calc(var(--space-section) * 0.65);
    background: var(--color-surface-alt);
  }

  .intro {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    margin-bottom: var(--space-3);
  }

  .service-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }

  @media (min-width: 768px) {
    .service-list {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-3) var(--space-4);
    }
  }

  .service-list li {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-2);
  }

  .service-list h3 {
    font-size: 1.05rem;
    margin-bottom: 0.35rem;
  }

  .service-list p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
</style>
