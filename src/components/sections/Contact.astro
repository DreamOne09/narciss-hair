---
import { SITE } from "../../config/site";

const { contact, business } = SITE;
---

<section id="contact" class="section">
  <div class="container">
    {contact.eyebrow && <p class="section-eyebrow">{contact.eyebrow}</p>}
    <h2>{contact.title}</h2>
    <p class="intro">{contact.intro}</p>

    <div class="contact-actions reveal">
      <a class="button" href={`tel:${business.phone}`}>{business.phoneDisplay}</a>
      <a
        class="button button-line"
        href={business.lineUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        LINE 預約
      </a>
      <a
        class="button button-secondary"
        href={business.instagramUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        Instagram
      </a>
    </div>
  </div>
</section>

<style>
  .intro {
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .contact-actions {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    max-width: 28rem;
  }

  @media (min-width: 480px) {
    .contact-actions {
      flex-direction: row;
      flex-wrap: wrap;
      max-width: none;
    }
  }

  .button-line {
    background: #06c755;
    color: #fff;
    border: none;
  }

  .button-line:hover {
    color: #fff;
    filter: brightness(0.95);
  }
</style>
