---
import { SITE } from "../config/site";

const { proposal, agency } = SITE;
---

<div
  id="demo-gate"
  class="proposal-gate"
  role="dialog"
  aria-modal="true"
  aria-labelledby="demo-gate-title"
  aria-describedby="demo-gate-desc"
>
  <div class="proposal-gate-inner">
    <div class="proposal-gate-panel">
      <p class="proposal-gate-kicker">{agency.name}</p>
      <h1 id="demo-gate-title">{proposal.gateTitle}</h1>
      <p id="demo-gate-desc" class="proposal-gate-body">{proposal.gateBody}</p>

      <form id="proposal-gate-form" class="proposal-gate-form" novalidate>
        <label for="proposal-password">{proposal.passwordLabel}</label>
        <input
          type="password"
          id="proposal-password"
          name="password"
          autocomplete="off"
          spellcheck="false"
          required
        />
        <p id="proposal-gate-error" class="proposal-gate-error" hidden role="alert"></p>
        <button type="submit" class="button proposal-gate-submit">{proposal.submitLabel}</button>
      </form>

      <p class="proposal-gate-note">{proposal.securityNote}</p>
    </div>
    <p class="proposal-gate-footer">{proposal.gateFooter}</p>
  </div>
</div>

<script define:vars={{ storageKey: proposal.storageKey, wrongMsg: proposal.wrongPassword }}>
  const EXPECTED = "demo";

  function lockScroll() {
    document.documentElement.classList.add("demo-gate-locked");
    document.body.classList.add("demo-gate-locked");
    document.getElementById("site-shell")?.classList.add("demo-gate-locked");
  }

  function unlockScroll() {
    document.documentElement.classList.remove("demo-gate-locked");
    document.body.classList.remove("demo-gate-locked");
    document.getElementById("site-shell")?.classList.remove("demo-gate-locked");
  }

  function preventScroll(e) {
    e.preventDefault();
  }

  const gate = document.getElementById("demo-gate");
  const form = document.getElementById("proposal-gate-form");
  const input = document.getElementById("proposal-password");
  const errorEl = document.getElementById("proposal-gate-error");

  if (gate && form && input) {
    if (sessionStorage.getItem(storageKey) === "1") {
      gate.remove();
    } else {
      lockScroll();
      window.addEventListener("wheel", preventScroll, { passive: false });
      window.addEventListener("touchmove", preventScroll, { passive: false });

      form.addEventListener("submit", (e) => {
        e.preventDefault();
        const value = input.value;
        if (value === EXPECTED) {
          sessionStorage.setItem(storageKey, "1");
          window.removeEventListener("wheel", preventScroll);
          window.removeEventListener("touchmove", preventScroll);
          unlockScroll();
          gate.remove();
          return;
        }
        if (errorEl) {
          errorEl.textContent = wrongMsg;
          errorEl.hidden = false;
        }
        input.focus();
      });
    }
  }
</script>

<style>
  .proposal-gate {
    position: fixed;
    inset: 0;
    z-index: 300;
    display: flex;
    flex-direction: column;
    background: var(--color-ink-navy);
    color: var(--color-dark-text);
    overflow: auto;
  }

  .proposal-gate-inner {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: var(--space-4) var(--space-3);
    min-height: 100dvh;
  }

  .proposal-gate-panel {
    width: min(100%, 28rem);
  }

  .proposal-gate-kicker {
    font-size: var(--text-sm);
    letter-spacing: 0.12em;
    color: var(--color-dark-text-muted);
    margin: 0 0 var(--space-2);
  }

  .proposal-gate-panel h1 {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 6vw, 2.35rem);
    font-weight: 600;
    margin-bottom: var(--space-2);
    color: var(--color-dark-text);
  }

  .proposal-gate-body {
    font-size: var(--text-sm);
    line-height: var(--leading);
    color: var(--color-dark-text-muted);
    margin-bottom: var(--space-3);
  }

  .proposal-gate-form label {
    display: block;
    font-size: var(--text-sm);
    font-weight: 600;
    margin-bottom: 0.35rem;
  }

  .proposal-gate-form input {
    width: 100%;
    min-height: 48px;
    padding: 0.65rem 0.85rem;
    border: 1px solid rgba(245, 241, 234, 0.25);
    border-radius: var(--radius-sm);
    background: rgba(0, 0, 0, 0.25);
    color: var(--color-dark-text);
    font-size: var(--text-base);
    margin-bottom: var(--space-1);
  }

  .proposal-gate-error {
    color: #f0a8a0;
    font-size: var(--text-sm);
    margin: 0 0 var(--space-1);
  }

  .proposal-gate-submit {
    width: 100%;
    min-height: 48px;
    margin-top: var(--space-1);
  }

  .proposal-gate-note {
    margin-top: var(--space-2);
    font-size: 0.75rem;
    color: var(--color-dark-text-muted);
    opacity: 0.85;
  }

  .proposal-gate-footer {
    margin-top: auto;
    padding-top: var(--space-4);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--color-dark-text-muted);
    text-align: center;
  }
</style>
