---
import { site } from "../config/site";
---

<div
  id="demo-gate"
  class="fixed inset-0 z-[100] flex items-center justify-center bg-ink/55 px-5 backdrop-blur-[2px]"
  role="dialog"
  aria-modal="true"
  aria-labelledby="demo-gate-title"
  aria-describedby="demo-gate-desc"
>
  <div
    class="w-full max-w-md rounded-sm border border-paper/15 bg-paper px-6 py-8 text-ink shadow-2xl"
  >
    <p
      id="demo-gate-title"
      class="font-display text-2xl font-semibold tracking-tight"
    >
      {site.demo.gateTitle}
    </p>
    <p id="demo-gate-desc" class="mt-4 text-sm leading-relaxed text-ink-muted">
      {site.demo.gateBody}
    </p>
    <p class="mt-3 text-xs text-ink-muted/80">{site.agency.credit}</p>
    <button
      type="button"
      id="demo-gate-enter"
      class="mt-8 min-h-11 w-full rounded-sm bg-ink px-4 py-3 text-sm font-medium tracking-wide text-paper transition-colors hover:bg-ink/90"
    >
      {site.demo.gateButton}
    </button>
  </div>
</div>

<script>
  import "../scripts/demo-gate.ts";
</script>
