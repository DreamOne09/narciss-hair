---
import { SITE } from "../config/site";
import { asset } from "../lib/paths";

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image = SITE.hero.image } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const absoluteImage = new URL(asset(image), Astro.site);
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={SITE.crawl.robotsMeta} />
<meta name="googlebot" content={SITE.crawl.robotsMeta} />
<link rel="canonical" href={canonical} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={absoluteImage} />
<meta property="og:locale" content={SITE.ogLocale} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteImage} />
