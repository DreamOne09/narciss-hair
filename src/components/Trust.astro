---
import { site } from "../config/site";
const { trust, business } = site;
---

<section id="trust" class="border-t border-ink/10 bg-ink py-16 text-paper md:py-24" aria-labelledby="trust-title">
  <div class="mx-auto max-w-6xl px-4 md:px-8">
    <header class="reveal max-w-2xl">
      <p class="text-[11px] tracking-[0.24em] text-accent-soft uppercase">Trust</p>
      <h2 id="trust-title" class="font-display mt-3 text-3xl font-semibold md:text-4xl">
        {trust.title}
      </h2>
      <p class="mt-4 text-sm leading-relaxed text-paper/75">{trust.lead}</p>
    </header>

    <ul class="mt-12 grid gap-10 md:grid-cols-3 md:gap-8">
      {
        trust.items.map((item) => (
          <li class="reveal border-t border-paper/15 pt-6">
            <h3 class="font-display text-xl font-semibold">{item.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-paper/75">{item.body}</p>
          </li>
        ))
      }
    </ul>

    <p class="reveal mt-12 text-sm text-paper/70">{trust.ctaNote}</p>
    <div class="reveal mt-6 flex flex-wrap gap-3">
      <a
        href={business.line}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-11 items-center rounded-sm bg-line-brand px-5 py-3 text-sm font-medium text-white"
      >
        {business.lineLabel}
      </a>
      <a
        href={business.instagram}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-11 items-center rounded-sm border border-paper/30 px-5 py-3 text-sm font-medium text-paper"
      >
        {business.igLabel}
      </a>
    </div>
  </div>
</section>
