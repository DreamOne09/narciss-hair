---
import { site } from "../config/site";
const { ctaBanner, business } = site;
---

<section
  class="border-t border-ink/10 bg-ink py-16 text-paper md:py-20"
  aria-labelledby="cta-title"
>
  <div class="mx-auto flex max-w-6xl flex-col gap-8 px-4 md:flex-row md:items-center md:justify-between md:px-8">
    <div class="reveal max-w-xl">
      <h2 id="cta-title" class="font-display text-3xl font-semibold md:text-4xl">
        {ctaBanner.title}
      </h2>
      <p class="mt-3 text-sm leading-relaxed text-paper/75">{ctaBanner.body}</p>
    </div>
    <div class="reveal flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
      <a
        href={business.phoneTel}
        data-cta="tel-footer"
        class="inline-flex min-h-11 items-center justify-center rounded-sm bg-paper px-6 py-3 text-sm font-medium text-ink"
      >
        {business.phoneLabel}
      </a>
      <a
        href={business.line}
        target="_blank"
        rel="noopener noreferrer"
        data-cta="line-footer"
        class="inline-flex min-h-11 items-center justify-center rounded-sm bg-line-brand px-6 py-3 text-sm font-medium text-white"
      >
        {business.lineLabel}
      </a>
    </div>
  </div>
</section>
