---
import { site } from "../config/site";
const { services } = site;
---

<section id="services" class="bg-paper py-16 md:py-24" aria-labelledby="services-title">
  <div class="mx-auto max-w-6xl px-4 md:px-8">
    <header class="reveal max-w-2xl">
      <p class="text-[11px] tracking-[0.24em] text-accent uppercase">Services</p>
      <h2 id="services-title" class="font-display mt-3 text-3xl font-semibold md:text-4xl">
        {services.title}
      </h2>
      <p class="mt-4 text-base leading-relaxed text-ink-muted">{services.lead}</p>
    </header>

    <div class="mt-12 space-y-16 md:mt-16 md:space-y-24">
      {
        services.items.map((item, index) => (
          <article
            class:list={[
              "reveal grid items-center gap-8 md:grid-cols-12 md:gap-10",
              index % 2 === 1 ? "md:[&>figure]:order-2 md:[&>div]:order-1" : "",
            ]}
          >
            <figure class="md:col-span-6">
              <div class="aspect-[4/3] overflow-hidden bg-paper-deep">
                <img
                  src={item.image}
                  alt={item.imageAlt}
                  width="960"
                  height="720"
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover transition-transform duration-700 hover:scale-[1.02]"
                />
              </div>
            </figure>
            <div class="md:col-span-6">
              <h3 class="font-display text-2xl font-semibold md:text-3xl">{item.title}</h3>
              <p class="mt-4 max-w-lg text-base leading-relaxed text-ink-muted">{item.body}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
