---
import { site } from "../config/site";
const { about } = site;
---

<section id="about" class="border-y border-ink/10 bg-paper-deep py-16 md:py-24" aria-labelledby="about-title">
  <div class="mx-auto grid max-w-6xl items-start gap-10 px-4 md:grid-cols-12 md:px-8">
    <div class="reveal md:col-span-5">
      <p class="text-[11px] tracking-[0.24em] text-accent uppercase">About</p>
      <h2 id="about-title" class="font-display mt-3 text-3xl font-semibold md:text-4xl">
        {about.title}
      </h2>
      {about.paragraphs.map((p) => (
        <p class="mt-5 text-base leading-relaxed text-ink-muted">{p}</p>
      ))}

      <dl class="mt-10 grid gap-6 border-t border-ink/10 pt-8 sm:grid-cols-3">
        {about.stats.map((stat) => (
          <div>
            <dt class="font-display text-2xl font-semibold text-ink">{stat.value}</dt>
            <dd class="mt-1 text-xs leading-relaxed text-ink-muted">{stat.label}</dd>
          </div>
        ))}
      </dl>
    </div>

    <figure class="reveal md:col-span-7">
      <div class="aspect-[5/6] overflow-hidden bg-paper">
        <img
          src={about.image}
          alt={about.imageAlt}
          width="1000"
          height="1200"
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover"
        />
      </div>
    </figure>
  </div>
</section>
