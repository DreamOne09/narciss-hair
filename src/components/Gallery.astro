---
import { site } from "../config/site";
const { gallery } = site;
---

<section id="gallery" class="bg-paper py-16 md:py-24" aria-labelledby="gallery-title">
  <div class="mx-auto max-w-6xl px-4 md:px-8">
    <header class="reveal flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div class="max-w-xl">
        <p class="text-[11px] tracking-[0.24em] text-accent uppercase">Gallery</p>
        <h2 id="gallery-title" class="font-display mt-3 text-3xl font-semibold md:text-4xl">
          {gallery.title}
        </h2>
        <p class="mt-3 text-sm text-ink-muted">{gallery.lead}</p>
      </div>
    </header>

    <div class="reveal mt-10 columns-1 gap-4 sm:columns-2 lg:columns-3">
      {
        gallery.images.map((img, i) => (
          <figure class="mb-4 break-inside-avoid overflow-hidden bg-paper-deep">
            <img
              src={img.src}
              alt={img.alt}
              width="800"
              height={i % 2 === 0 ? 1000 : 800}
              loading="lazy"
              decoding="async"
              class="w-full object-cover"
            />
          </figure>
        ))
      }
    </div>
  </div>
</section>
